{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/(.*\\.php)", "destination": "/api/index.php" },
    { "source": "/admin/(.*)", "destination": "/api/index.php" }
  ]
}
